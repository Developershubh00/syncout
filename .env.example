# ─────────────────────────────────────────────
#  SyncOut — environment
#  Copy to .env.local for dev, add to Vercel for prod
# ─────────────────────────────────────────────

# Neon Postgres (Vercel > Storage > Neon > .env.local tab)
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ── Admin panel ──
ADMIN_USERNAME="syncout.com"
ADMIN_PASSWORD="ganeshSHIV"
ADMIN_AUTH_KEY="ganeshSHIV@11"

# ── Vercel Blob (photo uploads) ──
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ── Email (Resend) — optional, wire up later ──
RESEND_API_KEY=""
MAIL_FROM="SyncOut <guestlist@syncout.in>"
MAIL_ENABLED="false"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE="+919999999999"

# Guestlist cutoff hour, 24h, Asia/Kolkata (18 = 6:00 PM)
GUESTLIST_CUTOFF_HOUR="18"
