# Copy to .env.local and fill in. Never commit .env.local.

# ── Database (Neon) ──────────────────────────────────────────────
# Use the POOLED url. Neon's pooler is what the serverless driver wants.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection. drizzle-kit push/migrate prefers this.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Sessions ─────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""

# ── Admin login (/admin) ─────────────────────────────────────────
# Required in production — there are no built-in defaults any more.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_AUTH_KEY="change-me-too"

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GUESTLIST_CUTOFF_HOUR="18"

# ── Live booking updates ─────────────────────────────────────────
# How often the live stream checks for news while something is pending, in ms.
LIVE_POLL_MS="3000"

# ── Photo uploads (Vercel Blob) ──────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Email (Resend) — off until you set these ─────────────────────
MAIL_ENABLED="false"
RESEND_API_KEY=""
MAIL_FROM="SyncOut <list@yourdomain.com>"

# ── Phone push notifications (Web Push) ──────────────────────────
# The v6 patch generates a pair into .env.local. Copy both to Vercel.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@yourdomain.com"

# ── Google Search Console (optional) ─────────────────────────────
# The content="" value from Search Console's HTML-tag method.
NEXT_PUBLIC_GSC_VERIFICATION=""
